# Source database (BillingRelay's own data); matches docker-compose.yml
DATABASE_URL=postgres://billingrelay:billingrelay@localhost:5433/billingrelay
# Destination database (stand-in for a merchant's database); leave empty for API-only
DESTINATION_DATABASE_URL=postgres://merchant:merchant@localhost:5434/merchant

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# Seeded by `pnpm db:seed`. Password must be at least 12 characters.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown by PayPal after saving the webhook (not the URL)
PAYPAL_WEBHOOK_ID=
