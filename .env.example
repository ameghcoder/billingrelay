# Source database (BillingRelay's own data); matches docker-compose.yml
DATABASE_URL=postgres://billingrelay:billingrelay@localhost:5433/billingrelay
# Worker only. The destination as BillingRelay's restricted role; leave empty for API-only. Not this machine: needs TLS (sslmode=verify-full)
DESTINATION_DATABASE_URL=postgres://billingrelay_sync:change-me@localhost:5434/merchant
# Only for `pnpm destination:setup`, run once by the destination's owner. Never give these to the worker.
DESTINATION_OWNER_URL=postgres://merchant:merchant@localhost:5434/merchant
DESTINATION_SYNC_PASSWORD=change-me

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# Seeded by `pnpm db:seed`. Password must be at least 12 characters.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# Web and worker. Encrypts stored PayPal secrets. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
# Web only. Public https address PayPal sends webhooks to (a tunnel locally, the Render URL when hosted)
PUBLIC_BASE_URL=
# Web only. The header your host's proxy sets to the client's IP, which a client can't set itself. Rate limits and
# sign-in count per address from it. Leave empty locally: every client then shares one count.
CLIENT_IP_HEADER=
