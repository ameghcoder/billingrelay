# Settings for docker-compose.selfhost.yml. Copy to .env.selfhost (never committed) and fill in. docs/self-host.md explains each.
# Passwords (they go inside database URLs, so hex): openssl rand -hex 24
SOURCE_DB_PASSWORD=
MERCHANT_DB_PASSWORD=
DESTINATION_SYNC_PASSWORD=
# Keys: openssl rand -base64 32 (SECRETS_ENCRYPTION_KEY must be exactly that: 32 bytes, base64)
BETTER_AUTH_SECRET=
SECRETS_ENCRYPTION_KEY=

# The first operator, created on the first start. Password at least 12 characters.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# A public https address that reaches this machine's port WEB_PORT (a tunnel such as ngrok), for PayPal's webhooks and the buyer.
PUBLIC_BASE_URL=
WEB_PORT=3100

# Optional: AI setup and investigation.
OPENAI_API_KEY=

# The example merchant app. Create a backend key in BillingRelay's Developers page, put it here, and run `up -d merchant-app` again.
BILLINGRELAY_API_KEY=
EXAMPLE_PRODUCTS=pro
EXAMPLE_APP_PORT=3200
