{
  "name": "@billingrelay/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --external:pg-native --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/index.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@billingrelay/billing": "workspace:*",
    "@billingrelay/db": "workspace:*",
    "@billingrelay/provider-paypal": "workspace:*",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
