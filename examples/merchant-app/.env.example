# The example merchant app. Copy to .env.local in this folder.
# Where BillingRelay runs, and a backend key from its Developers page. The key stays on this server.
BILLINGRELAY_URL=http://localhost:3100
BILLINGRELAY_API_KEY=
# This app's own database: the destination BillingRelay syncs into. A read-only role is enough.
MERCHANT_DATABASE_URL=postgres://merchant:merchant@localhost:5434/merchant
# This app's public address, for PayPal to send the buyer back to.
EXAMPLE_APP_URL=http://localhost:3200
# What the Buy buttons sell, from your live catalog: product, or product:variant, comma separated.
EXAMPLE_PRODUCTS=pro
